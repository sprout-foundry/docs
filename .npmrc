# @sprout-foundry/* packages come from GitHub Packages, not npmjs. The only
# per-environment input is the token, supplied as NODE_AUTH_TOKEN:
#
#   local:  export NODE_AUTH_TOKEN=$(gh auth token)   # needs read:packages
#   CI:     NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }} with packages: read
#
# GitHub Packages requires a token even to read.
@sprout-foundry:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
